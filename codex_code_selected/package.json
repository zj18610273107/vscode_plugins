{
  "name": "codex-code-selected",
  "displayName": "Codex Code Selected",
  "description": "Send selected code to Codex CLI for analysis, review, or transformation",
  "version": "0.1.13",
  "publisher": "codex-publisher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex 选中代码发送",
      "properties": {
        "codex.autoSubmit": {
          "type": "boolean",
          "default": false,
          "description": "将选中的代码粘贴到 Codex CLI 终端后，是否自动按回车提交。"
        },
        "codex.prefix": {
          "type": "string",
          "default": "",
          "description": "发送选中代码时添加的前缀。前缀非空时，会在前缀后换行再附加原始代码。"
        }
      }
    },
    "commands": [
      {
        "command": "codex.sendSelectedCode",
        "title": "Codex: 发送选中代码到 CLI（带前缀）"
      },
      {
        "command": "codex.sendSelectedCodeWithoutPrefix",
        "title": "Codex: 发送选中代码到 CLI（不带前缀）"
      },
      {
        "command": "codex.smartTerminalPaste",
        "title": "Codex: 终端智能粘贴"
      }
    ],
    "keybindings": [
      {
        "command": "codex.sendSelectedCode",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "codex.smartTerminalPaste",
        "key": "ctrl+v",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "terminal/context": [
        {
          "command": "codex.smartTerminalPaste",
          "group": "navigation@1",
          "when": "terminalFocus"
        }
      ],
      "editor/context": [
        {
          "command": "codex.sendSelectedCode",
          "group": "codex@1",
          "when": "editorTextFocus"
        },
        {
          "command": "codex.sendSelectedCodeWithoutPrefix",
          "group": "codex@2",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No build step required'"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
